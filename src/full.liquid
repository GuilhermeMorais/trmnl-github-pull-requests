<div class="layout layout--col">
  <div class="title">
    <i class="ti ti-brand-github"> </i>
    Open Pull Requests — status color demo
  </div>

  <div class="grid grid--cols-1 gap--small h--full">
    <div data-overflow="true" data-overflow-counter="true" data-overflow-max-cols="1">
      <div class="flex flex--col">

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--green rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="approved-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request"></i>
              Add color status chips to the PR list
              <span class="label label--small">#101</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-plugins
              <i class="ti ti-user-circle"></i> octocat
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;5</span>
              <span class="label label--small label--underline">on 07/01 at 20:40</span>
            </div>
          </div>
        </div>

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--red rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="changes-requested-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request"></i>
              Refactor the GraphQL query builder
              <span class="label label--small">#102</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-plugins
              <i class="ti ti-user-circle"></i> reviewer-bot
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;5</span>
              <span class="label label--small label--underline">on 06/01 at 09:12</span>
            </div>
          </div>
        </div>

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--yellow rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="commented-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request"></i>
              Bump tabler-icons to 3.30.0
              <span class="label label--small">#103</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-plugins
              <i class="ti ti-user-circle"></i> copilot-pull-request-reviewer
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;5</span>
              <span class="label label--small label--underline">on 05/01 at 14:22</span>
            </div>
          </div>
        </div>

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--yellow rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="pending-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request-draft"></i>
              WIP: ePaper preview caching
              <span class="label label--small">#104</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-github-pull-requests
              <i class="ti ti-user-circle"></i> alex-dev
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;2</span>
              <span class="label label--small label--underline">on 04/01 at 11:00</span>
            </div>
          </div>
        </div>

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--yellow rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="review-required-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request"></i>
              Add README screenshots
              <span class="label label--small">#105</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-github-pull-requests
              <i class="ti ti-user-circle"></i> No reviewer
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;0</span>
            </div>
          </div>
        </div>

        <div class="item">
          <div class="meta w--8">
            <span class="index bg--gray-20 rounded--small flex flex--center w--8 h--8" data-pixel-perfect="true">
              <div class="need-attention-icon svg-icon"></div>
            </span>
          </div>
          <div class="content">
            <span class="title title--small">
              <i class="ti ti-git-pull-request-draft"></i>
              Draft: split shared markup into partials
              <span class="label label--small">#106</span>
            </span>
            <span class="description">
              <i class="ti ti-world"></i> GuilhermeMorais/trmnl-github-pull-requests
              <i class="ti ti-user-circle"></i> No reviewer
            </span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline"><i class="ti ti-message"></i> &nbsp;0</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
<div class="title_bar">
  <i class="ti ti-git-pull-request"></i>
  <span class="title">Pull Requests of {{ username }}</span>
</div>
