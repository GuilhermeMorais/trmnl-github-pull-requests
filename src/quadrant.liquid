<div class="layout layout--col">
  <div class="label">
    <i class="ti ti-brand-github">&nbsp;</i>Open Pull Requests
  </div>
  {% assign nodes = data.search.nodes %}
  {% if nodes.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-counter="true" data-overflow-max-cols="1">
    <div class="column">
      {% for pr in nodes %}
      {% assign latest_review = pr.reviews.nodes | reject: 'author.login', username | sort: 'submittedAt' | last %}
      {% assign review_status = pr.reviewDecision | default: latest_review.state %}

      {% case review_status %}
        {% when 'APPROVED' %}{% assign status_bg = 'bg--green' %}
        {% when 'CHANGES_REQUESTED' %}{% assign status_bg = 'bg--red' %}
        {% when 'COMMENTED' %}{% assign status_bg = 'bg--yellow' %}
        {% when 'PENDING' %}{% assign status_bg = 'bg--yellow' %}
        {% when 'REVIEW_REQUIRED' %}{% assign status_bg = 'bg--yellow' %}
        {% else %}{% assign status_bg = 'bg--gray-20' %}
      {% endcase %}

      <div class="item">
        <div class="meta w--6">
          <span class="index {{ status_bg }} rounded--small flex flex--center w--6 h--6" data-pixel-perfect="true">
            {% case review_status %}
              {% when 'APPROVED' %}
                <div class="approved-icon svg-icon-small"></div>
              {% when 'CHANGES_REQUESTED' %}
                <div class="changes-requested-icon svg-icon-small"></div>
              {% when 'COMMENTED' %}
                <div class="commented-icon svg-icon-small"></div>
              {% when 'PENDING' %}
                <div class="pending-icon svg-icon-small"></div>
              {% when 'REVIEW_REQUIRED' %}
                <div class="review-required-icon svg-icon-small"></div>
              {% else %}
                <div class="need-attention-icon svg-icon-small"></div>
            {% endcase %}
          </span>
        </div>
        <div class="content">
          <span class="title title--small">
            {% if pr.isDraft %}
              <i class="ti ti-git-pull-request-draft"></i>
            {% else %}
              <i class="ti ti-git-pull-request"></i>
            {% endif %}
            {{ pr.title | truncate: 40 }}
            <span class="label label--small">#{{ pr.number }}</span>
          </span>
          <span class="description">
            <i class="ti ti-world"></i> {{ pr.repository.name }}
            <span class="label label--small label--underline">
              <i class="ti ti-message"></i> &nbsp;{{ pr.comments.totalCount }}
            </span>
          </span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="layout layout--col flex flex--center">
    <i class="ti ti-check"></i>
    <span>No pull requests open</span>
  </div>
  {% endif %}
</div>
<div class="title_bar">
  <i class="ti ti-brand-github"></i>
  <span class="title">Open Pull Requests of {{ username }}</span>
</div>
