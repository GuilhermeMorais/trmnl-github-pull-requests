<div class="layout layout--col">
  {% assign nodes = data.search.nodes %}
  {% if nodes.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-counter="true" data-overflow-max-cols="2">
    <div class="column">
      {% for pr in nodes %}
      {% assign latest_review = pr.reviews.nodes | reject: 'author.login', username | sort: 'submittedAt' | last %}
      {% assign review_status = pr.reviewDecision | default: latest_review.state %}

      {% case review_status %}
        {% when 'APPROVED' %}{% assign status_bg = 'bg--success' %}
        {% when 'CHANGES_REQUESTED' %}{% assign status_bg = 'bg--error' %}
        {% when 'COMMENTED' %}{% assign status_bg = 'bg--warning' %}
        {% when 'PENDING' %}{% assign status_bg = 'bg--warning' %}
        {% when 'REVIEW_REQUIRED' %}{% assign status_bg = 'bg--warning' %}
        {% else %}{% assign status_bg = 'bg--gray-20' %}
      {% endcase %}

      <div class="item">
        <div class="meta w--7 {{ status_bg }} rounded--small flex flex--center">
          {% case review_status %}
            {% when 'APPROVED' %}
              <div class="approved-icon svg-icon"></div>
            {% when 'CHANGES_REQUESTED' %}
              <div class="changes-requested-icon svg-icon"></div>
            {% when 'COMMENTED' %}
              <div class="commented-icon svg-icon"></div>
            {% when 'PENDING' %}
              <div class="pending-icon svg-icon"></div>
            {% when 'REVIEW_REQUIRED' %}
              <div class="review-required-icon svg-icon"></div>
            {% else %}
              <div class="need-attention-icon svg-icon"></div>
          {% endcase %}
        </div>
        <div class="content">
          <span class="title title--small">
            {% if pr.isDraft %}
              <i class="ti ti-git-pull-request-draft"></i>
            {% else %}
              <i class="ti ti-git-pull-request"></i>
            {% endif %}
            {{ pr.title | truncate: 50 }}
            <span class="label label--small">#{{ pr.number }}</span>
          </span>
          <span class="description">
            <i class="ti ti-world"></i> {{ pr.repository.nameWithOwner | truncate: 40 }}
            {% if latest_review %}
              {% assign comments = latest_review.comments.totalCount | plus: 0 %}
              <i class="ti ti-message"></i> {{ comments | plus: pr.comments.totalCount }}
              <i class="ti ti-user-circle"></i> {{ latest_review.author.login | truncate: 35 }}
            {% else %}
              <i class="ti ti-user-circle"></i> No reviewer
              {% assign comments = 0 %}
            {% endif %}
          </span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="layout layout--row flex flex--center">
    <i class="ti ti-check"></i>
    <span>No pull requests open</span>
  </div>
  {% endif %}
</div>
<div class="title_bar">
  <i class="ti ti-brand-github"></i>
  <span class="title">Open Pull Requests of {{ username }}</span>
</div>
